# LexForge / Legal-Trial — environment variable template
# Copy to .env.local for local development (never commit secrets).
# Vercel: set the same keys in Project → Settings → Environment Variables.
#
# Do not put real API keys or secrets in this file.

# Required for AI chat, personas, drafting, performance, and Dreadler LLM turns.
# Used by: /api/chat, /api/dreadler
# Aliases also accepted by chat: DEEPSEEK_CHAT_API_KEY, DEEPSEEK_REASONER_API_KEY
DEEPSEEK_API_KEY=

# Optional. Sarvam AI for mic STT and "Read Aloud" TTS via /api/voice.
# Without it, voice degrades gracefully (browser TTS may still work; mic STT off).
SARVAM_API_KEY=

# Optional for same-origin app traffic. Comma-separated additional browser origins
# allowed to call public /api/* routes. The serving HTTPS host is allowed exactly;
# localhost (3000, 3001, 5173) is allowed in api/_lib/security.js and dreadler.py.
# Alias: APP_ORIGIN
# Example: https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=

# Required for Dreadler arena. Long random secret used to HMAC-sign simulation
# state tokens between turns. Missing → /api/dreadler returns 503.
# Generate e.g.: openssl rand -hex 32
DREADLER_STATE_SECRET=

# Optional. Indian Kanoon API for structured SC/HC caselaw via /api/caselaw.
# Without it, public-web discovery only (unverified leads).
INDIANKANOON_API_KEY=
