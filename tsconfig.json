{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "types.ts",
    "constants.ts",
    "routes.ts",
    "kokuConfig.ts",
    "subjectPersonalities.ts",
    "vite-env.d.ts",
    "vite.config.ts",
    "components/**/*",
    "screens/**/*",
    "services/**/*",
    "hooks/**/*",
    "utils/**/*",
    "assets/**/*",
    "vision/**/*",
    "api/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "Projects",
    "dreadler"
  ]
}