{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run check",
  "outputDirectory": "dist",
  "functions": {
    "api/dreadler.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,assets/**,vision/**,docs/**,screens/**,components/**,services/**,hooks/**,utils/**,public/**,Projects/**,**/*.{tsx,ts,jsx,css,map},**/*.{jpg,jpeg,png,svg,webp,wasm}}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
